DATABASE_URL="postgresql://user:password@localhost:5432/wackonight?schema=public"
PORT=3000
# Public HTTPS URL of this site (Bachs refuses localhost/private success URLs, even in sandbox)
APP_URL="https://your-domain.example"
TRUST_PROXY=1
# Long random strings: openssl rand -hex 32
SESSION_SECRET=""
ADMIN_PASSWORD=""
# Bachs (Bach.io): sk_sandbox_... for testing, sk_live_... for production
BACHS_API_KEY=""
# Signing secret of the webhook endpoint created in the Bachs developer portal
BACHS_WEBHOOK_SECRET=""
